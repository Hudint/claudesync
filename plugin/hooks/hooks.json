{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "claudesync hook session-start", "timeout": 30 } ] }
    ],
    "ConfigChange": [
      { "hooks": [ { "type": "command", "command": "claudesync hook config-change", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "claudesync hook session-end", "timeout": 10 } ] }
    ]
  }
}
